<!-- HEADER -->
<div class="app-header">
  <div class="app-logo">CUCA.</div>
  <div class="app-client">
    <label>Cliente</label>
    <input type="text" id="clientName" placeholder="Caio Galvão" value="Caio Galvão" oninput="updateClientName()" />
  </div>
  <div class="app-actions">
    <button class="btn-app btn-print" onclick="window.print()">Imprimir / PDF</button>
    <button class="btn-app btn-clear" onclick="clearAll()">Limpar tudo</button>
  </div>
</div>

<!-- CATEGORIES BAR -->
<div class="cat-bar" id="categoriesBar">
