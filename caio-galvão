const PRESET_VERSION = 'v3-agosto';

function buildPresetState() {
  return {
    _version: PRESET_VERSION,
    clientName: 'Caio Galvão',
    content: { ...PRESET_CONTENT },
    categories: { ...PRESET_CATS },
    notes: { ...PRESET_NOTES },
    weeks: { ...PRESET_WEEKS },
    refs: JSON.parse(JSON.stringify(PRESET_REFS)),
    dirs: JSON.parse(JSON.stringify(PRESET_DIRS)),
  };
}

function loadState() {
  try {
    const saved = JSON.parse(localStorage.getItem('caio-cal-2026') || 'null');
    if (!saved || saved._version !== PRESET_VERSION) {
      // Versão desatualizada — mescla preservando edições do usuário mas injeta novos presets
      const fresh = buildPresetState();
      if (saved) {
        // Preserva edições manuais do usuário (content, activeMonth, clientName)
        fresh.clientName = saved.clientName || fresh.clientName;
        fresh.activeMonth = saved.activeMonth;
        // Mescla content: preset como base, edições do usuário por cima
        fresh.content = { ...fresh.content, ...saved.content };
        fresh.categories = { ...fresh.categories, ...saved.categories };
        // Notas/semanas/refs/dirs: só preservar meses que já existiam (5 e 6), agosto vem dos presets
        [5, 6].forEach(m => {
          if (saved.notes && saved.notes[m]) fresh.notes[m] = saved.notes[m];
          if (saved.weeks) [1,2,3,4].forEach(w => {
            const k = `${m}-${w}`;
            if (saved.weeks[k]) fresh.weeks[k] = saved.weeks[k];
          });
          if (saved.refs && saved.refs[m]) fresh.refs[m] = saved.refs[m];
          if (saved.dirs && saved.dirs[m]) fresh.dirs[m] = saved.dirs[m];
        });
        // postEdits preservados
        if (saved.postEdits) fresh.postEdits = saved.postEdits;
      }
      localStorage.setItem('caio-cal-2026', JSON.stringify(fresh));
      return fresh;
    }
    return saved;
  } catch(e) {
    return buildPresetState();
  }
}

