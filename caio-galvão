const WEEKDAYS = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];

// ---- CONTEÚDO PRÉ-POPULADO ----
const PRESET_CONTENT = {
  // JUNHO
  '5-18': '🎬 REEL 1 — São João\n"Guia de sobrevivência calórica do arraiá"\n📍 Gravar no mercado 12-14/06',
