<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Calendário de Conteúdo 2026 — Caio Galvão | CUCA.</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root {
  --orange:    #EB5416;
  --terracota: #A25C45;
  --gold:      #D9A063;
  --cream:     #DDD0C0;
  --offwhite:  #F7F3EE;
  --dark:      #1A1210;
  --mid:       #3D2B25;
  --font-title:'Sora', sans-serif;
  --font-body: 'Montserrat', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  background: var(--offwhite);
  color: var(--dark);
  min-height: 100vh;
}

/* ---- HEADER ---- */
.app-header {
  background: var(--dark);
  padding: 1rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 20px rgba(0,0,0,0.3);
}
.app-logo {
  font-family: var(--font-title);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--orange);
  letter-spacing: -0.02em;
}
.app-client {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.app-client label {
  font-family: var(--font-title);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(221,208,192,0.5);
}
.app-client input {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 2px;
  padding: 0.5rem 0.9rem;
  font-family: var(--font-title);
  font-size: 0.85rem;
  font-weight: 600;
  color: #fff;
  width: 220px;
  outline: none;
  transition: border-color 0.3s;
}
.app-client input:focus { border-color: var(--orange); }
.app-client input::placeholder { color: rgba(255,255,255,0.25); }
.app-actions { display: flex; gap: 0.7rem; }
.btn-app {
  font-family: var(--font-title);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 0.55rem 1.2rem;
  border-radius: 2px;
  border: none;
  cursor: pointer;
  transition: all 0.3s;
}
.btn-print {
  background: var(--orange);
  color: #fff;
  box-shadow: 0 2px 12px rgba(235,84,22,0.35);
}
.btn-print:hover { background: #d94a10; }
.btn-clear {
  background: transparent;
  color: rgba(255,255,255,0.4);
  border: 1px solid rgba(255,255,255,0.15);
}
.btn-clear:hover { color: #ff6b6b; border-color: #ff6b6b; }

/* ---- CATEGORIES BAR ---- */
.cat-bar {
  background: #fff;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  padding: 0.75rem 2rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  position: sticky;
  top: 64px;
  z-index: 90;
  box-shadow: 0 1px 8px rgba(0,0,0,0.04);
}
.cat-label {
  font-family: var(--font-title);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #999;
  margin-right: 0.5rem;
}
.cat-pill {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
  font-family: var(--font-title);
  font-size: 0.65rem;
  font-weight: 700;
  border: 1.5px solid transparent;
  cursor: default;
  transition: transform 0.2s;
}
.cat-pill:hover { transform: translateY(-1px); }
.cat-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

/* ---- MONTH NAV ---- */
.month-nav {
  background: #fff;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  padding: 0 2rem;
  position: sticky;
  top: 112px;
  z-index: 80;
}
.month-tabs { display: flex; gap: 0; overflow-x: auto; }
.month-tab {
  font-family: var(--font-title);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.85rem 1.1rem;
  border: none;
  background: transparent;
  color: #aaa;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}
.month-tab:hover { color: var(--orange); }
.month-tab.active { color: var(--dark); border-bottom-color: var(--orange); }
.month-tab.has-content { color: var(--terracota); }
.month-tab.has-content.active { color: var(--dark); border-bottom-color: var(--orange); }

/* ---- CALENDAR WRAP ---- */
.calendar-wrap { padding: 2rem; }
.month-view { display: none; }
.month-view.active { display: block; }

/* PRINT */
.print-header {
  display: none;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--orange);
}
@media print { .print-header { display: flex !important; } }

/* ---- MONTH HEADER ---- */
.month-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  gap: 2rem;
  flex-wrap: wrap;
}
.month-title {
  font-family: var(--font-title);
  font-size: 2rem;
  font-weight: 800;
  color: var(--dark);
  letter-spacing: -0.02em;
}
.month-title span { color: var(--orange); }
.month-note-wrap { flex: 1; min-width: 200px; }
.month-note-label {
  font-family: var(--font-title);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #aaa;
  display: block;
  margin-bottom: 0.4rem;
}
.month-note {
  width: 100%;
  border: 1.5px solid rgba(0,0,0,0.1);
  border-radius: 4px;
  padding: 0.55rem 0.9rem;
  font-family: var(--font-body);
  font-size: 0.8rem;
  color: var(--dark);
  background: #fff;
  outline: none;
  transition: border-color 0.2s;
}
.month-note:focus { border-color: var(--orange); }

/* ---- CALENDAR GRID ---- */
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 3px;
  background: rgba(0,0,0,0.06);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 20px rgba(0,0,0,0.06);
}
.cal-weekday {
  background: var(--dark);
  color: rgba(255,255,255,0.6);
  font-family: var(--font-title);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.7rem;
  text-align: center;
}
.cal-day {
  background: #fff;
  min-height: 130px;
  padding: 0.5rem;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  transition: background 0.15s;
}
.cal-day:hover { background: #faf8f5; }
.cal-day.empty { background: rgba(0,0,0,0.02); }
.cal-day.today {
  background: #fff8f4;
  outline: 2px solid var(--orange);
  outline-offset: -2px;
}
.day-num {
  font-family: var(--font-title);
  font-size: 0.85rem;
  font-weight: 700;
  color: #bbb;
  line-height: 1;
}
.day-num.sunday { color: #d4a5a5; }
.cal-day.today .day-num { color: var(--orange); }

/* ---- TAGS ---- */
.day-tags { display: flex; flex-wrap: wrap; gap: 3px; }
.day-tag {
  font-family: var(--font-title);
  font-size: 0.55rem;
  font-weight: 700;
  padding: 0.18rem 0.5rem;
  border-radius: 3px;
  cursor: pointer;
  transition: opacity 0.2s;
  letter-spacing: 0.02em;
}
.day-tag:hover { opacity: 0.75; }

/* ---- CONTENT ---- */
.day-content {
  flex: 1;
  border: none;
  outline: none;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.68rem;
  color: #555;
  background: transparent;
  line-height: 1.5;
  width: 100%;
}
.day-content::placeholder { color: #ccc; }

/* ---- ADD CAT BUTTON ---- */
.day-add-cat {
  position: absolute;
  bottom: 5px;
  right: 5px;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--orange);
  color: #fff;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.2s;
  line-height: 1;
  font-weight: 300;
}
.cal-day:hover .day-add-cat { opacity: 0.7; }
.day-add-cat:hover { opacity: 1 !important; }

/* ---- PICKER ---- */
.cat-picker {
  display: none;
  position: absolute;
  bottom: 28px;
  right: 0;
  background: #fff;
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 6px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  z-index: 200;
  min-width: 200px;
  overflow: hidden;
}
.cat-picker.open { display: block; }
.cat-picker-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.55rem 1rem;
  font-family: var(--font-title);
  font-size: 0.68rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
  color: var(--dark);
}
.cat-picker-item:hover { background: var(--offwhite); }

/* ---- ESTRATÉGIA BANNER ---- */
.estrategia-banner {
  background: linear-gradient(135deg, var(--dark) 0%, #2D1A12 100%);
  border-radius: 8px;
  padding: 1.5rem 1.8rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
  border-left: 4px solid var(--orange);
}
.estrategia-icon { font-size: 1.8rem; flex-shrink: 0; }
.estrategia-label {
  font-family: var(--font-title);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--orange);
  margin-bottom: 0.3rem;
}
.estrategia-titulo {
  font-family: var(--font-title);
  font-size: 1rem;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.4rem;
}
.estrategia-desc {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: rgba(221,208,192,0.7);
  line-height: 1.6;
}

/* ---- POSTS PLANEJADOS ---- */
.posts-planejados {
  background: #fff;
  border-radius: 8px;
  margin-top: 1.5rem;
  border: 1px solid rgba(0,0,0,0.07);
  overflow: hidden;
}
.posts-header {
  background: var(--dark);
  padding: 0.8rem 1.2rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}
.posts-header-title {
  font-family: var(--font-title);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(221,208,192,0.8);
}
.posts-header-badge {
  background: var(--orange);
  color: #fff;
  font-family: var(--font-title);
  font-size: 0.58rem;
  font-weight: 700;
  padding: 0.15rem 0.6rem;
  border-radius: 20px;
}
.posts-lista {
  padding: 1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}
.post-item {
  border-left: 3px solid #eee;
  padding: 0.7rem 1rem;
  background: var(--offwhite);
  border-radius: 0 6px 6px 0;
  transition: border-color 0.2s;
}
.post-item:hover { border-left-color: var(--orange); }
.post-item-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.3rem;
  flex-wrap: wrap;
}
.post-item-data {
  font-family: var(--font-title);
  font-size: 0.62rem;
  font-weight: 700;
  color: #aaa;
}
.post-item-cat {
  font-family: var(--font-title);
  font-size: 0.6rem;
  font-weight: 700;
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
  letter-spacing: 0.03em;
}
.post-item-titulo {
  font-family: var(--font-title);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--dark);
  margin-bottom: 0.2rem;
}
.post-item-desc {
  font-family: var(--font-body);
  font-size: 0.7rem;
  color: #777;
  line-height: 1.5;
}
.post-item-roteiro {
  margin-top: 0.5rem;
  background: rgba(235,84,22,0.05);
  border-radius: 4px;
  padding: 0.6rem 0.8rem;
  border: 1px solid rgba(235,84,22,0.1);
}
.post-item-roteiro-label {
  font-family: var(--font-title);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--orange);
  margin-bottom: 0.3rem;
}
.post-item-roteiro-text {
  font-family: var(--font-body);
  font-size: 0.68rem;
  color: #555;
  line-height: 1.65;
  white-space: pre-line;
}

/* ---- REF BLOCKS ---- */
.ref-block {
  background: #fff;
  border-radius: 8px;
  margin-top: 1.5rem;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.07);
}
.ref-block-header {
  background: var(--mid);
  padding: 0.8rem 1.2rem;
}
.ref-block-title {
  font-family: var(--font-title);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(221,208,192,0.8);
}
.ref-block-body { padding: 1rem 1.2rem; }
.ref-col-labels {
  display: grid;
  grid-template-columns: 1fr 2fr 28px;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}
.ref-col-label {
  font-family: var(--font-title);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #bbb;
}
.ref-row { display: grid; grid-template-columns: 1fr 2fr 28px; gap: 0.5rem; margin-bottom: 0.4rem; align-items: center; }
.dir-row { display: grid; grid-template-columns: 1fr 28px; gap: 0.5rem; margin-bottom: 0.4rem; align-items: center; }
.ref-input, .dir-input {
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 4px;
  padding: 0.45rem 0.7rem;
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--dark);
  outline: none;
  transition: border-color 0.2s;
  background: #fafaf8;
  width: 100%;
}
.ref-input:focus, .dir-input:focus { border-color: var(--orange); background: #fff; }
.ref-remove {
  background: none;
  border: none;
  color: #ccc;
  cursor: pointer;
  font-size: 0.8rem;
  padding: 0.2rem;
  transition: color 0.2s;
}
.ref-remove:hover { color: #ff6b6b; }
.ref-add-btn {
  background: none;
  border: 1px dashed rgba(235,84,22,0.3);
  color: var(--orange);
  font-family: var(--font-title);
  font-size: 0.68rem;
  font-weight: 600;
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  cursor: pointer;
  margin-top: 0.5rem;
  transition: all 0.2s;
}
.ref-add-btn:hover { background: rgba(235,84,22,0.05); border-style: solid; }

/* ---- SEMANAS ---- */
.week-strategy {
  background: #fff;
  border-radius: 8px;
  margin-top: 1.5rem;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.07);
}
.week-strategy-header {
  background: var(--mid);
  padding: 0.8rem 1.2rem;
}
.week-strategy-title {
  font-family: var(--font-title);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(221,208,192,0.8);
}
.week-rows { padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
.week-row { display: grid; grid-template-columns: 90px 1fr; gap: 0.8rem; align-items: center; }
.week-label {
  font-family: var(--font-title);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--orange);
  letter-spacing: 0.05em;
}
.week-input {
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 4px;
  padding: 0.45rem 0.7rem;
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--dark);
  outline: none;
  background: #fafaf8;
  transition: border-color 0.2s;
}
.week-input:focus { border-color: var(--orange); background: #fff; }

/* ---- LEGEND ---- */
.cat-legend {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
  padding: 1.5rem 0 0.5rem;
}

@media (max-width: 900px) {
  .cal-grid { gap: 2px; }
  .cal-day { min-height: 90px; }
  .day-tag { font-size: 0.52rem; }
  .calendar-wrap { padding: 1rem; }
  .app-header { flex-wrap: wrap; gap: 0.7rem; }
}

@media print {
  .app-header, .cat-bar, .month-nav, .day-add-cat, .cat-picker { display: none !important; }
  .print-header { display: flex !important; }
  .month-view { display: block !important; }
  .calendar-wrap { padding: 0; }
  body { background: #fff; }
}
</style>
</head>
