    tabs.appendChild(tab);
  });
}

function switchMonth(idx) {
  activeMonth = idx;
  state.activeMonth = idx;
  saveState();
  document.querySelectorAll('.month-tab').forEach((t, i) => t.classList.toggle('active', i === idx));
  document.querySelectorAll('.month-view').forEach((m, i) => m.classList.toggle('active', i === idx));
}

