// ============================================
// REF SECTION
// ============================================
function buildRefSection(mIdx) {
  return `
    <div class="ref-block">
      <div class="ref-block-header"><span class="ref-block-title">Referências de Conteúdo</span></div>
      <div class="ref-block-body">
        <div class="ref-col-labels">
          <span class="ref-col-label">Perfil / @conta</span>
          <span class="ref-col-label">O que referencia</span>
          <span></span>
        </div>
        <div id="ref-rows-${mIdx}"></div>
        <button class="ref-add-btn" onclick="addRefRow(${mIdx})">+ adicionar referência</button>
      </div>
    </div>
    <div class="ref-block">
      <div class="ref-block-header"><span class="ref-block-title">Direcionamento de Conteúdo</span></div>
      <div class="ref-block-body">
        <div id="dir-rows-${mIdx}"></div>
        <button class="ref-add-btn" onclick="addDirRow(${mIdx})">+ adicionar direcionamento</button>
      </div>
    </div>`;
}

// ============================================
// CATEGORY PICKER
// ============================================
function togglePicker(e, mIdx, d) {
  e.stopPropagation();
  const picker = document.getElementById(`picker-${mIdx}-${d}`);
  const isOpen = picker.classList.contains('open');
  document.querySelectorAll('.cat-picker.open').forEach(p => p.classList.remove('open'));
  if (!isOpen) { picker.classList.add('open'); openPicker = `picker-${mIdx}-${d}`; }
  else openPicker = null;
}
document.addEventListener('click', () => {
  if (openPicker) { const p = document.getElementById(openPicker); if (p) p.classList.remove('open'); openPicker = null; }
});
function addCategory(mIdx, d, catId) {
  const key = `${mIdx}-${d}`;
  if (!state.categories) state.categories = {};
  if (!state.categories[key]) state.categories[key] = [];
  if (!state.categories[key].includes(catId)) { state.categories[key].push(catId); renderTags(mIdx, d); saveState(); }
  const picker = document.getElementById(`picker-${mIdx}-${d}`);
  if (picker) picker.classList.remove('open');
}
function removeCategory(mIdx, d, catId) {
  const key = `${mIdx}-${d}`;
  if (state.categories && state.categories[key]) {
    state.categories[key] = state.categories[key].filter(c => c !== catId);
    renderTags(mIdx, d); saveState();
  }
}
function renderTags(mIdx, d) {
  const key = `${mIdx}-${d}`;
  const container = document.getElementById(`tags-${mIdx}-${d}`);
  if (!container) return;
  const cats = (state.categories && state.categories[key]) || [];
  container.innerHTML = cats.map(catId => {
    const cat = CATEGORIES.find(c => c.id === catId);
    if (!cat) return '';
    return `<div class="day-tag" style="background:${cat.bg};color:${cat.color};"
                 onclick="removeCategory(${mIdx}, ${d}, '${catId}')"
                 title="Clique para remover">${cat.label}</div>`;
  }).join('');
}

// ============================================
// SAVE / LOAD
// ============================================
function saveContent(mIdx, d, value) {
  if (!state.content) state.content = {};
  state.content[`${mIdx}-${d}`] = value;
  saveState();
}
function saveNote(mIdx, value) {
  if (!state.notes) state.notes = {};
  state.notes[mIdx] = value;
  saveState();
}
function saveWeek(mIdx, week, value) {
  if (!state.weeks) state.weeks = {};
  state.weeks[`${mIdx}-${week}`] = value;
  saveState();
}
function saveState() {
  try { localStorage.setItem('caio-cal-2026', JSON.stringify(state)); } catch(e) {}
}
function restoreState() {
  if (state.content) Object.entries(state.content).forEach(([key, val]) => {
    const el = document.getElementById(`content-${key}`); if (el) el.value = val;
  });
  if (state.categories) Object.keys(state.categories).forEach(key => {
    const parts = key.split('-'); renderTags(parseInt(parts[0]), parseInt(parts[1]));
  });
  if (state.notes) Object.entries(state.notes).forEach(([mIdx, val]) => {
    const el = document.getElementById(`note-${mIdx}`); if (el) el.value = val;
  });
  MONTHS.forEach((_, mIdx) => {
    renderRefRows(mIdx); renderDirRows(mIdx);
    [1,2,3,4].forEach(w => {
      const el = document.getElementById(`week-${mIdx}-${w}`);
      if (el && state.weeks && state.weeks[`${mIdx}-${w}`]) el.value = state.weeks[`${mIdx}-${w}`];
    });
  });
}
function updateClientName() {
  const name = document.getElementById('clientName').value;
  state.clientName = name; saveState();
  document.querySelectorAll('[id^="print-client-"]').forEach(el => el.textContent = name);
}
function clearAll() {
  if (confirm('Limpar todo o calendário? Esta ação não pode ser desfeita.')) {
    state = { clientName: 'Caio Galvão' };
    localStorage.removeItem('caio-cal-2026');
    document.querySelectorAll('.day-content').forEach(el => el.value = '');
    document.querySelectorAll('.month-note').forEach(el => el.value = '');
    document.querySelectorAll('.day-tags').forEach(el => el.innerHTML = '');
    document.querySelectorAll('.week-input').forEach(el => el.value = '');
    MONTHS.forEach((_, mIdx) => { renderRefRows(mIdx); renderDirRows(mIdx); });
  }
}

// ============================================
// REFS & DIRS
// ============================================
function addRefRow(mIdx) {
  if (!state.refs) state.refs = {};
  if (!state.refs[mIdx]) state.refs[mIdx] = [];
  state.refs[mIdx].push({ profile: '', about: '' });
  renderRefRows(mIdx); saveState();
}
function saveRef(mIdx, idx, field, value) {
  if (!state.refs) state.refs = {};
  if (!state.refs[mIdx]) state.refs[mIdx] = [];
  if (!state.refs[mIdx][idx]) state.refs[mIdx][idx] = { profile: '', about: '' };
  state.refs[mIdx][idx][field] = value; saveState();
}
function removeRefRow(mIdx, idx) {
  if (state.refs && state.refs[mIdx]) {
    state.refs[mIdx].splice(idx, 1); renderRefRows(mIdx); saveState();
  }
}
function renderRefRows(mIdx) {
  const container = document.getElementById(`ref-rows-${mIdx}`);
  if (!container) return;
  const rows = (state.refs && state.refs[mIdx]) || [];
  if (rows.length === 0) {
    container.innerHTML = `<div class="ref-row">
      <input class="ref-input" placeholder="@perfil" oninput="saveRef(${mIdx}, 0, 'profile', this.value)" />
      <input class="ref-input" placeholder="referência para qual conteúdo" oninput="saveRef(${mIdx}, 0, 'about', this.value)" />
      <span></span></div>`; return;
  }
  container.innerHTML = rows.map((row, idx) => `
    <div class="ref-row">
      <input class="ref-input" placeholder="@perfil" value="${(row.profile||'').replace(/"/g,'&quot;')}"
             oninput="saveRef(${mIdx}, ${idx}, 'profile', this.value)" />
      <input class="ref-input" placeholder="referência para qual conteúdo" value="${(row.about||'').replace(/"/g,'&quot;')}"
             oninput="saveRef(${mIdx}, ${idx}, 'about', this.value)" />
      <button class="ref-remove" onclick="removeRefRow(${mIdx}, ${idx})">✕</button>
    </div>`).join('');
}
function addDirRow(mIdx) {
  if (!state.dirs) state.dirs = {};
  if (!state.dirs[mIdx]) state.dirs[mIdx] = [];
  state.dirs[mIdx].push(''); renderDirRows(mIdx); saveState();
}
function saveDir(mIdx, idx, value) {
  if (!state.dirs) state.dirs = {};
  if (!state.dirs[mIdx]) state.dirs[mIdx] = [];
  state.dirs[mIdx][idx] = value; saveState();
}
function removeDirRow(mIdx, idx) {
  if (state.dirs && state.dirs[mIdx]) {
    state.dirs[mIdx].splice(idx, 1); renderDirRows(mIdx); saveState();
  }
}
function renderDirRows(mIdx) {
  const container = document.getElementById(`dir-rows-${mIdx}`);
  if (!container) return;
  const rows = (state.dirs && state.dirs[mIdx]) || [];
  if (rows.length === 0) {
    container.innerHTML = `<div class="dir-row">
      <input class="dir-input" placeholder="ex: semana 1 foca em autoridade..."
             oninput="saveDir(${mIdx}, 0, this.value)" />
      <span></span></div>`; return;
  }
  container.innerHTML = rows.map((row, idx) => `
    <div class="dir-row">
      <input class="dir-input" value="${(row||'').replace(/"/g,'&quot;')}"
             placeholder="direcionamento de conteúdo..."
             oninput="saveDir(${mIdx}, ${idx}, this.value)" />
      <button class="ref-remove" onclick="removeDirRow(${mIdx}, ${idx})">✕</button>
    </div>`).join('');
}

