</div>

<!-- MONTH NAV -->
<div class="month-nav">
  <div class="month-tabs" id="monthTabs"></div>
</div>

<!-- CALENDAR -->
<div class="calendar-wrap" id="calendarWrap"></div>

<script>
// ============================================
